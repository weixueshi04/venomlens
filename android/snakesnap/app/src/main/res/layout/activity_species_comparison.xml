<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FAF8F3">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">

        <Button
            android:id="@+id/species_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="64dp"
            android:minHeight="48dp"
            android:text="返回" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="照片比对"
            android:textColor="#193E38"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/species_hospital"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="就医目录" />
    </LinearLayout>

    <TextView
        android:id="@+id/species_safety"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FBE4DE"
        android:padding="12dp"
        android:text="仅用于比对照片，不能判断有没有毒；被咬伤立即就医。"
        android:textColor="#82281E"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/species_result_source"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#E0EAE5"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:textColor="#193E38"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/species_action_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityLiveRegion="polite"
        android:padding="12dp"
        android:textColor="#82281E"
        android:textSize="16sp"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/species_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/species_loading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:paddingVertical="12dp"
                android:text="正在读取离线比对资料…"
                android:textColor="#193E38"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/species_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="12dp"
                android:textColor="#82281E"
                android:textSize="18sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/species_review"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFF0D5"
                android:padding="12dp"
                android:text="比对文案待审核；不作为医疗或毒性判断依据。"
                android:textColor="#65480C"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/species_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/species_common_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:textColor="#193E38"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/species_scientific_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#485D57"
                    android:textSize="18sp"
                    android:textStyle="italic" />

                <TextView
                    android:id="@+id/species_aliases"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="#263C36"
                    android:textSize="16sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/species_catalog_source"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:autoLink="none"
                    android:linksClickable="false"
                    android:textColor="#485D57"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/species_profile_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="#FFF0D5"
                    android:padding="12dp"
                    android:text="暂无离线比对文案，按未知处理。"
                    android:textColor="#65480C"
                    android:textSize="18sp" />

                <LinearLayout
                    android:id="@+id/species_profile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/species_hook"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:textColor="#193E38"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="只观察已有照片 · 以下文案待审核"
                        android:textColor="#193E38"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/species_checklist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="6dp"
                        android:textColor="#263C36"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/species_do_not"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:background="#FBE4DE"
                        android:lineSpacingExtra="6dp"
                        android:padding="12dp"
                        android:textColor="#82281E"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/species_look_alikes_toggle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:minHeight="48dp"
                        android:text="展开易混淆项（待审核）" />

                    <TextView
                        android:id="@+id/species_look_alikes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="6dp"
                        android:padding="12dp"
                        android:textColor="#263C36"
                        android:textSize="17sp"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="离线参考图 · 来源与授权"
                    android:textColor="#193E38"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/species_images"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="外部参考资料（仅手动打开）"
                    android:textColor="#193E38"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="点击后离开应用并使用网络；外部内容不代表已经审核。"
                    android:textColor="#485D57"
                    android:textSize="16sp" />

                <LinearLayout
                    android:id="@+id/species_external_refs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
