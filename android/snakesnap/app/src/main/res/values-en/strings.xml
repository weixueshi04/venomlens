    <string name="emergency_flow_image_io_failed">Could not read the image; you can still record the injury.</string>
    <string name="emergency_flow_image_security_failed">Could not access the image; you can still record the injury.</string>
    <string name="emergency_flow_image_invalid_failed">Image invalid or over the 2 MB limit; you can still record the injury.</string>
    <string name="emergency_flow_video_skipped_title">That was a video, so no analysis</string>
    <string name="emergency_flow_video_skipped_detail">The emergency flow handles photos only. You can still record the injury and get help.</string>
    <string name="emergency_flow_fetch_failed_title">Could not fetch the photo</string>
    <string name="emergency_flow_fetch_failed_detail">No match in the camera gallery after about 10 seconds. You can download it manually on the Gallery page. You can still record the injury and get help.</string>
    <string name="emergency_flow_download_failed_title">Photo download failed</string>
    <string name="emergency_flow_download_failed_detail">An error occurred while fetching the photo. You can download it manually on the Gallery page. You can still record the injury and get help.</string>
