    <string name="emergency_flow_stage_pending_refreshing">Querying once…</string>
    <string name="emergency_flow_pending_refreshing_detail">This single manual query only; if it is still processing, you can check again later by hand.</string>
    <string name="emergency_flow_consent_required_title">Upload not consented, photo not sent</string>
    <string name="emergency_flow_consent_required_detail">Live recognition needs you to tick “Allow uploading the photo” first. No network request was made. Tick it and capture again to recognize; you can also record the injury and get help directly.</string>
    <string name="emergency_flow_recognition_failed_suffix">A failed recognition does not mean there is no snake; it does not retry automatically. You can still record the injury and get help.</string>
